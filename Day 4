              #leetcode 125 (valid palindrome)
class Solution:
    def isPalindrome(self, s: str) -> bool:
        l=""
        l=s.lower()
        res=""
        flag=0
        
        for i in range(0,len(l)):
            if l[i].isalnum():
                res+=l[i]
        i=0
        j=len(res)-1
        while(i<=j):
            if(res[i]==res[j]):
                i+=1
                j-=1
            else:
                flag=1
                break
        if(flag==1):
            return False
        else:
            return True


