class Solution:
    def missingNumber(self, nums: List[int]) -> int:
        l=len(nums)
        x1,x2=0,0
        for i in range(l+1): #actual xor value within the range
            x1=x1^i
        for i in nums:# xor of values in list
            x2=x2^i
        return x1^x2 #xor both to get the missing element


